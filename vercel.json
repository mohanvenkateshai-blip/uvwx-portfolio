{
  "rewrites": [
    {
      "source": "/",
      "destination": "/portfolio_v8.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "uvwx.ie"
        }
      ],
      "destination": "https://www.uvwx.me/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.uvwx.ie"
        }
      ],
      "destination": "https://www.uvwx.me/$1",
      "permanent": true
    }
  ]
}
